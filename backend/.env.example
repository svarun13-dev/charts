# AstroTrader Backend Configuration

# App Settings
DEBUG=true
APP_NAME=AstroTrader
APP_VERSION=1.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./astrotrader.db

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Market Data API Keys (optional)
ALPHA_VANTAGE_API_KEY=
COINMARKETCAP_API_KEY=

# Vedic Astrology Settings
VEDIC_AYANAMSA=lahiri

# Signal Settings
SIGNAL_CHECK_INTERVAL=300
ASPECT_ORB_DEFAULT=8.0

# Cache
CACHE_TTL=60
